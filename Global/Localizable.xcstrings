    "maintenance_need_msg": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "车机系统提示需要进行常规保养检查，请及时预约售后服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "汽車系統提示需要進行日常維護和檢查。 請及時預約售後服務。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The car system prompts that routine maintenance and inspection are required. Please make an appointment for after-sales service in time."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araç sistemi rutin bakım ve incelemenin gerekli olduğunu talep eder. Lütfen satış sonrası servis için zamanında randevu alın."
          }
        }
      }
    },
    "maintenance_need_no": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
