  "shortcuts_help" : {
    "extractionState" : "manual",
    "localizations" : {
      "en" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "Available: vehicle status, parking position, ride marker, HUD, navigation and gas station search. The xp400:// Scheme remains supported."
        }
      },
      "tr" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "Kullanılabilir: araç durumu, park konumu, sürüş işareti, HUD, navigasyon ve benzin istasyonu arama. xp400:// Scheme desteği sürer."
        }
      },
      "zh-Hans" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "可用：查询车辆状态、查看停车位置、标记行程、打开 HUD、导航和查找加油站。旧 xp400:// Scheme 仍兼容。"
        }
      },
      "zh-Hant" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "可用：查詢車輛狀態、查看停車位置、標記行程、開啟 HUD、導航和尋找加油站。舊 xp400:// Scheme 仍相容。"
        }
      }
    }
  },
