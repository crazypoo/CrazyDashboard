        "en" : { "stringUnit" : { "state" : "translated", "value" : "App Shortcuts are registered automatically. Open XP400RIDE in Shortcuts to view, combine, or customize the six supported intents." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "App Kestirmeleri otomatik olarak kaydedilir. Desteklenen altı intent'i görüntülemek, birleştirmek veya özelleştirmek için Kestirmeler'de XP400RIDE'ı açın." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "App 快捷指令会自动注册。打开快捷指令中的 XP400RIDE，即可查看、组合或自定义这 6 个 Intent。" } },
