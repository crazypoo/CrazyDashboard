    "short_cut_fuel" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri stellte fest, dass nur %d % l Reste im Treibstoff waren. Klicken Sie zum Bestätigen und navigieren Sie zur nächsten Tankstelle!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri found that there was only %d% left in the fuel. Click to confirm and navigate to the nearest gas station!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri descubrió que solo quedaba %d % l en el combustible. ¡Haga clic para confirmar y navegar hasta la gasolinera más cercana!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri a découvert qu'il ne restait que %d % l dans le carburant. Cliquez pour confirmer et accédez à la station-service la plus proche !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri ha scoperto che c'erano solo %d % l a sinistra nel carburante. Clicca per confermare e raggiungi il distributore di benzina più vicino!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri, yakıtta sadece %%d kaldığını tespit etti. Onaylamak ve en yakın benzin istasyonuna gitmek için tıklayın!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri发现油量仅剩 %d%，点击确认导航至最近加油站！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri發現燃料只剩下%d%了。 點選確認並導航到最近的加油站！"
          }
        }
      }
    },
