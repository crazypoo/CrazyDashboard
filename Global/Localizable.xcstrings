    "maintenance_warning_msg" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zur nächsten Wartung sind nur noch %@ übrig. Für das beste Fahrerlebnis bereiten Sie bitte die Materialien im Voraus vor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are only %@ left before the next maintenance. For the best riding experience, please prepare the supplies in advance."
