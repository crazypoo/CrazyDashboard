    "shortcuts_help" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Available: vehicle status, parking position, ride marker, HUD, navigation and gas station search. The xp400:// Scheme remains supported."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Available: vehicle status, parking position, ride marker, HUD, navigation and gas station search. The xp400:// Scheme remains supported."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponible: estado del vehículo, posición de estacionamiento, marcador de recorrido, HUD, navegación y búsqueda de gasolineras. El esquema xp400:// sigue siendo compatible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponible : état du véhicule, position de stationnement, marqueur de trajet, HUD, navigation et recherche de station-service. Le schéma xp400:// reste pris en charge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Available: vehicle status, parking position, ride marker, HUD, navigation and gas station search. The xp400:// Scheme remains supported."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanılabilir: araç durumu, park konumu, sürüş işareti, HUD, navigasyon ve benzin istasyonu arama. xp400:// Scheme desteği sürer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用：查询车辆状态、查看停车位置、标记行程、打开 HUD、导航和查找加油站。旧 xp400:// Scheme 仍兼容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用：查詢車輛狀態、查看停車位置、標記行程、開啟 HUD、導航和尋找加油站。舊 xp400:// Scheme 仍相容。"
          }
        }
      }
    },
