    "dashboard_notification_guide_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "XP400 system notification setup" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "XP400 sistem bildirim kurulumu" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "XP400 系统通知设置" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "XP400 系統通知設定" } }
      }
    },
    "dashboard_notification_guide_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "1. Open Settings > Bluetooth > XP400 and enable Share System Notifications.\n2. Check Notifications > Show Previews.\n3. Review Focus mode and per-app notification settings.\n4. Return to the app and send the test notification." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "1. Ayarlar > Bluetooth > XP400 bölümünü açın ve Sistem Bildirimlerini Paylaş seçeneğini etkinleştirin.\n2. Bildirimler > Önizlemeleri Göster seçeneğini kontrol edin.\n3. Odak modunu ve uygulama bildirim ayarlarını inceleyin.\n4. Uygulamaya dönüp test bildirimini gönderin." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "1. 打开“设置”>“蓝牙”>“XP400”，开启“共享系统通知”。\n2. 检查“通知”>“显示预览”。\n3. 检查专注模式和各 App 的通知设置。\n4. 返回本 App，发送测试通知。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "1. 開啟「設定」>「藍牙」>「XP400」，啟用「分享系統通知」。\n2. 檢查「通知」>「顯示預覽」。\n3. 檢查專注模式和各 App 的通知設定。\n4. 返回本 App，傳送測試通知。" } }
      }
    },
