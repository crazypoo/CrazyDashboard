    "address_empty" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben die Adresse noch nicht festgelegt. Bitte lange drücken oder die Adresse in der Suchliste auswählen, um sie zu speichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have not set the address yet. Please long press or select the address in the search list to save it."
