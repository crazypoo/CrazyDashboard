    "automation_guide_scheme_explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Copy a supported xp400:// link into Shortcuts, Safari, or another app. Copying never executes the route here." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Desteklenen bir xp400:// bağlantısını Kestirmeler'e, Safari'ye veya başka bir uygulamaya kopyalayın. Kopyalama burada rotayı çalıştırmaz." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将支持的 xp400:// 链接复制到快捷指令、Safari 或其他 App 中。本页面复制示例时不会执行路由。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "將支援的 xp400:// 連結複製到快捷指令、Safari 或其他 App。本頁面複製範例時不會執行路由。" } }
      }
    },
    "automation_guide_scheme_copy" : {
