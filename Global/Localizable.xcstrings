    },
    "maintenance_warning_msg": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "距离下次保养仅剩 %d公里，为了最佳骑行体验，请提前准备耗材。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "距離下一次維修只剩下%d公里了。 為了獲得最佳的騎行體驗，請提前準備好用品。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are only %dkilometres left before the next maintenance. For the best riding experience, please prepare the supplies in advance."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sonraki bakıma sadece %d kilometre kaldı. En iyi sürüş deneyimi için lütfen malzemeleri önceden hazırlayın."
          }
        }
      }
    },
    "maintenance_warning_title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保养里程预警"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "維護里程警告"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenance mileage warning"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakım kilometre uyarısı"
          }
        }
      }
    },
    "moto_down_msg": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "车辆姿态极度异常，请立即检查车辆与人员状况\n（扶正车身将自动解除警报）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "車輛的姿態非常不正常。 請立即檢查車輛和人員的狀況\n（正確的車身將自動解除警報）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The posture of the vehicle is extremely abnormal. Please check the condition of the vehicle and the personnel immediately\n (the correct body will automatically lift the alarm)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aracın duruşu son derece anormal. Lütfen aracın ve personelin durumunu derhal kontrol edin\n (doğru gövde alarmı otomatik olarak kaldıracaktır)"
          }
        }
      }
    },
    "moto_down_title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "侦测到摔车 / 倒地"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測到摔車 / 倒地"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detected car fall / fall to the ground"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arabadan düştüğü / yere düştüğü tespit edildi"
          }
        }
      }
