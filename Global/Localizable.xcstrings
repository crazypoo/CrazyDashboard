        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no has configurado la dirección. Mantenga presionada o seleccione la dirección en la lista de búsqueda para guardarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
