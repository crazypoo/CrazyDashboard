    "automation_guide_summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Use Siri, the Shortcuts app, or an xp400:// link to view motorcycle data and open supported riding flows. This page explains every available action without executing it." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Motosiklet verilerini görüntülemek ve desteklenen sürüş akışlarını açmak için Siri, Kestirmeler veya bir xp400:// bağlantısı kullanın. Bu sayfa tüm işlemleri açıklar ancak hiçbirini çalıştırmaz." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可以使用 Siri、快捷指令或 xp400:// 链接查看摩托车数据并打开支持的骑行流程。本页面只介绍能力，不会直接执行操作。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "可以使用 Siri、快捷指令或 xp400:// 連結查看摩托車資料並開啟支援的騎行流程。本頁面只介紹功能，不會直接執行操作。" } }
      }
    },
