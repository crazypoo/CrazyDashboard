    "address_empty": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您尚未设置该地址，请先在搜索列表中长按或选择地址进行保存。"
          }
