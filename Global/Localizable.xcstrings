      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die aktuelle statische Spannung beträgt nur %.1f V und es besteht die Gefahr, dass sie nicht gestartet werden kann. Bitte laden Sie es so schnell wie möglich auf."
          }
        },
        "en" : {
          "stringUnit" : {
