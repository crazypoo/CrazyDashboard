        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "URL Scheme 已复制" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "URL Scheme 已複製" } }
      }
    },
    "automation_guide_faq_section" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Notes" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Notlar" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用说明" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "使用說明" } }
      }
    },
    "automation_guide_faq" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Vehicle status and parking actions use the latest saved data and may be stale. HUD, navigation, and fuel actions need the app scene and their normal location or connection conditions. antiTheft changes monitoring state, so keep its copied link in a trusted shortcut only. The canonical route form is xp400://route; the legacy xp400://action/route form remains compatible." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Araç durumu ve park işlemleri en son kaydedilen verileri kullanır ve güncel olmayabilir. HUD, navigasyon ve yakıt işlemleri uygulama sahnesini ve normal konum veya bağlantı koşullarını gerektirir. antiTheft izleme durumunu değiştirir; bu nedenle kopyalanan bağlantıyı yalnızca güvenilir bir kestirmede kullanın. Önerilen biçim xp400://route şeklindedir; eski xp400://action/route biçimi uyumludur." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "车辆状态和停车操作使用最近保存的数据，可能不是实时值。HUD、导航和加油站操作需要 App 场景以及正常的定位或连接条件。antiTheft 会改变防盗监控状态，复制后的链接应只放在可信的快捷指令中。推荐格式为 xp400://route，旧的 xp400://action/route 格式仍然兼容。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "車輛狀態和停車操作使用最近保存的資料，可能不是即時值。HUD、導航和加油站操作需要 App 場景以及正常的定位或連線條件。antiTheft 會改變防盜監控狀態，複製後的連結應只放在可信的快捷指令中。建議格式為 xp400://route，舊的 xp400://action/route 格式仍然相容。" } }
      }
    },
    "automation_scheme_check_fuel_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Check fuel" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yakıtı kontrol et" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "查询油量" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "查詢油量" } }
      }
    },
    "automation_scheme_check_fuel_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Read the current dashboard fuel value and notify the rider; low fuel can start the gas station flow." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Güncel gösterge yakıt değerini okur ve sürücüyü bilgilendirir; düşük yakıt benzin istasyonu akışını başlatabilir." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "读取当前仪表油量并提示骑手；油量过低时可能启动加油站流程。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "讀取目前儀表油量並提示騎手；油量過低時可能啟動加油站流程。" } }
      }
    },
    "automation_scheme_check_fuel_note" : {
