    "maintenance_need_msg" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fahrzeugsystem weist darauf hin, dass routinemäßige Wartung und Inspektion erforderlich sind. Bitte vereinbaren Sie rechtzeitig einen Termin für den Kundendienst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The car system prompts that routine maintenance and inspection are required. Please make an appointment for after-sales service in time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sistema del automóvil indica que se requieren inspecciones y mantenimiento de rutina. Concierte una cita para el servicio posventa a tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le système du véhicule indique qu'un entretien et une inspection de routine sont nécessaires. Veuillez prendre rendez-vous à temps pour le service après-vente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sistema dell'auto segnala la necessità di manutenzione e ispezione di routine. Si prega di fissare in tempo un appuntamento per il servizio post-vendita."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Araç sistemi rutin bakım ve incelemenin gerekli olduğunu talep eder. Lütfen satış sonrası servis için zamanında randevu alın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "车机系统提示需要进行常规保养检查，请及时预约售后服务。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "汽車系統提示需要進行日常維護和檢查。 請及時預約售後服務。"
          }
        }
      }
    },
