    "security_monitoring_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitoring arms only after a fresh engine-off frame. Location verification may suppress an alarm when accuracy is insufficient."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitoring arms only after a fresh engine-off frame. Location verification may suppress an alarm when accuracy is insufficient."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brazos de control sólo después de un nuevo cuadro con el motor apagado. La verificación de la ubicación puede suprimir una alarma cuando la precisión es insuficiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surveillance des bras uniquement après un nouveau cadre d'arrêt du moteur. La vérification de l'emplacement peut supprimer une alarme lorsque la précision est insuffisante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bracci di monitoraggio solo dopo un nuovo telaio a motore spento. La verifica della posizione può sopprimere un allarme quando la precisione è insufficiente."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzleme yalnızca güncel bir motor kapalı çerçevesinden sonra kurulur. Doğruluk yetersizse konum doğrulaması alarmı bastırabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有收到新鲜的熄火数据后才会布防。定位精度不足时会抑制报警。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有收到新鮮的熄火資料後才會佈防。定位精度不足時會抑制警報。"
          }
        }
      }
    },
