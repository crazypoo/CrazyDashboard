    "batt_warning_msg": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前静态电压仅 %.1fV，存在无法启动的风险，请尽快充电。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電流靜態電壓只有%.1fV，存在無法啟動的風險。 請儘快充電。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current static voltage is only %.1fV, and there is a risk that it cannot be started. Please charge it as soon as possible."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut statik voltaj sadece %.1fV'dur ve başlatılamama riski vardır. Lütfen mümkün olan en kısa sürede şarj edin."
          }
        }
      }
    },
