    "dashboard_notification_guide_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Open Settings > Bluetooth > XP400 and enable Share System Notifications.\n2. Check Notifications > Show Previews and Focus settings.\n3. Keep PTSpeed connected, close the Peugeot app, and lock the iPhone.\n4. Use another phone to place a real call and send a real SMS; test third-party app notifications separately."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Open Settings > Bluetooth > XP400 and enable Share System Notifications.\n2. Check Notifications > Show Previews and Focus settings.\n3. Keep PTSpeed connected, close the Peugeot app, and lock the iPhone.\n4. Use another phone to place a real call and send a real SMS; test third-party app notifications separately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Open Settings > Bluetooth > XP400 and enable Share System Notifications.\n2. Check Notifications > Show Previews and Focus settings.\n3. Keep PTSpeed connected, close the Peugeot app, and lock the iPhone.\n4. Use another phone to place a real call and send a real SMS; test third-party app notifications separately."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Open Settings > Bluetooth > XP400 and enable Share System Notifications.\n2. Check Notifications > Show Previews and Focus settings.\n3. Keep PTSpeed connected, close the Peugeot app, and lock the iPhone.\n4. Use another phone to place a real call and send a real SMS; test third-party app notifications separately."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Apri Impostazioni > Bluetooth > XP400 e attiva Condividi notifiche di sistema.\n2. Controlla Notifiche > Mostra anteprime e impostazioni Focus.\n3. Mantieni connesso PTSpeed, chiudi l'app Peugeot e blocca l'iPhone.\n4. Utilizza un altro telefono per effettuare una vera chiamata e inviare un vero SMS; testare separatamente le notifiche delle app di terze parti."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Ayarlar > Bluetooth > XP400 bölümünü açın ve Sistem Bildirimlerini Paylaş seçeneğini etkinleştirin.\n2. Bildirimler > Önizlemeleri Göster ve Odak ayarlarını kontrol edin.\n3. PTSpeed'i bağlı tutun, Peugeot uygulamasını kapatın ve iPhone'u kilitleyin.\n4. Başka bir telefondan gerçek bir arama yapın ve gerçek bir SMS gönderin; üçüncü taraf uygulama bildirimlerini ayrıca test edin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 打开“设置”>“蓝牙”>“XP400”，开启“共享系统通知”。\n2. 检查“通知”>“显示预览”和“专注模式”设置。\n3. 保持 PTSpeed 连接，退出 Peugeot 官方 App，并锁定 iPhone。\n4. 使用另一台手机拨打真实电话并发送真实短信；第三方 App 通知请单独测试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 開啟「設定」>「藍牙」>「XP400」，啟用「分享系統通知」。\n2. 檢查「通知」>「顯示預覽」和「專注模式」設定。\n3. 保持 PTSpeed 連線，退出 Peugeot 官方 App，並鎖定 iPhone。\n4. 使用另一支手機撥打真實電話並傳送真實訊息；第三方 App 通知請另外測試。"
          }
        }
      }
    },
