    "automation_guide_faq" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vehicle status and parking actions use the latest saved data and may be stale. HUD, navigation, and fuel actions need the app scene and their normal location or connection conditions. antiTheft changes monitoring state, so keep its copied link in a trusted shortcut only. The canonical route form is xp400://route; the legacy xp400://action/route form remains compatible."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vehicle status and parking actions use the latest saved data and may be stale. HUD, navigation, and fuel actions need the app scene and their normal location or connection conditions. antiTheft changes monitoring state, so keep its copied link in a trusted shortcut only. The canonical route form is xp400://route; the legacy xp400://action/route form remains compatible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vehicle status and parking actions use the latest saved data and may be stale. HUD, navigation, and fuel actions need the app scene and their normal location or connection conditions. antiTheft changes monitoring state, so keep its copied link in a trusted shortcut only. The canonical route form is xp400://route; the legacy xp400://action/route form remains compatible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vehicle status and parking actions use the latest saved data and may be stale. HUD, navigation, and fuel actions need the app scene and their normal location or connection conditions. antiTheft changes monitoring state, so keep its copied link in a trusted shortcut only. The canonical route form is xp400://route; the legacy xp400://action/route form remains compatible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vehicle status and parking actions use the latest saved data and may be stale. HUD, navigation, and fuel actions need the app scene and their normal location or connection conditions. antiTheft changes monitoring state, so keep its copied link in a trusted shortcut only. The canonical route form is xp400://route; the legacy xp400://action/route form remains compatible."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Araç durumu ve park işlemleri en son kaydedilen verileri kullanır ve güncel olmayabilir. HUD, navigasyon ve yakıt işlemleri uygulama sahnesini ve normal konum veya bağlantı koşullarını gerektirir. antiTheft izleme durumunu değiştirir; bu nedenle kopyalanan bağlantıyı yalnızca güvenilir bir kestirmede kullanın. Önerilen biçim xp400://route şeklindedir; eski xp400://action/route biçimi uyumludur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "车辆状态和停车操作使用最近保存的数据，可能不是实时值。HUD、导航和加油站操作需要 App 场景以及正常的定位或连接条件。antiTheft 会改变防盗监控状态，复制后的链接应只放在可信的快捷指令中。推荐格式为 xp400://route，旧的 xp400://action/route 格式仍然兼容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "車輛狀態和停車操作使用最近保存的資料，可能不是即時值。HUD、導航和加油站操作需要 App 場景以及正常的定位或連線條件。antiTheft 會改變防盜監控狀態，複製後的連結應只放在可信的快捷指令中。建議格式為 xp400://route，舊的 xp400://action/route 格式仍然相容。"
          }
        }
      }
    },
